<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <WindowsSdkPackageVersion>10.0.19041.57</WindowsSdkPackageVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\app_icon.ico</ApplicationIcon>
    <Version>2.1.0</Version>
    <Product>R - Wallpaper Studio</Product>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableMsixTooling>false</EnableMsixTooling>
    <AssemblyName>WallpaperStudio</AssemblyName>
    <RootNamespace>WallpaperStudio</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\WallpaperWorker\WallpaperWorker.csproj" ReferenceOutputAssembly="false" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <Content Include="Assets\**\*" Exclude="Assets\Cafe.png;Assets\Home.png;Assets\Default.png;Assets\LockScreen.png" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="..\StudioPaths.cs" Link="StudioPaths.cs" />
    <Content Include="..\WallpaperService.exe" Link="WallpaperService.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\app_icon.ico" Link="app_icon.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="BuildWallpaperBackend" BeforeTargets="BeforeBuild">
    <Exec Command="&quot;$(WINDIR)\Microsoft.NET\Framework64\v4.0.30319\csc.exe&quot; /nologo /target:winexe /win32icon:&quot;$(MSBuildProjectDirectory)\..\app_icon.ico&quot; /out:&quot;$(MSBuildProjectDirectory)\..\WallpaperService.exe&quot; /reference:System.Windows.Forms.dll /reference:System.Drawing.dll /reference:System.Device.dll /reference:System.Web.Extensions.dll &quot;$(MSBuildProjectDirectory)\..\WallpaperService.cs&quot; &quot;$(MSBuildProjectDirectory)\..\StudioPaths.cs&quot; &quot;$(MSBuildProjectDirectory)\..\ModernTrayMenu.cs&quot;" />
  </Target>
  <Target Name="CopyBackgroundWorker" AfterTargets="Build;Publish">
    <ItemGroup>
      <WorkerFiles Include="..\WallpaperWorker\bin\$(Configuration)\$(TargetFramework)\win-x64\WallpaperWorker.exe;..\WallpaperWorker\bin\$(Configuration)\$(TargetFramework)\win-x64\WallpaperWorker.dll;..\WallpaperWorker\bin\$(Configuration)\$(TargetFramework)\win-x64\WallpaperWorker.deps.json;..\WallpaperWorker\bin\$(Configuration)\$(TargetFramework)\win-x64\WallpaperWorker.runtimeconfig.json" />
    </ItemGroup>
    <Copy SourceFiles="@(WorkerFiles)" DestinationFolder="$(TargetDir)" />
    <Copy SourceFiles="@(WorkerFiles)" DestinationFolder="$(PublishDir)" Condition="'$(PublishDir)' != ''" />
  </Target>
</Project>
